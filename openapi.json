{"openapi":"3.1.0","info":{"title":"Khmer Government Document Intelligence System","description":"Production-ready pure REST API for Khmer Government Document Intelligence System. Digitizes, recognizes (Khmer + English OCR), classifies, and archives Cambodian administrative documents (Birth Certificates, Family Books, IDs, Letters, Forms, Receipts).","version":"1.0.0"},"paths":{"/api/v1/documents/upload":{"post":{"tags":["Documents"],"summary":"Upload And Process Document","description":"Securely uploads a Cambodian government document:\n1. Validates magic bytes, size limit, and file integrity.\n2. Stores in isolated, UUID-hashed storage.\n3. Preprocesses with OpenCV (deskew, CLAHE contrast enhancement, noise filter, binarization).\n4. Executes OCR in Khmer and English (khm+eng).\n5. Performs automated classification into official categories.\n6. If classified as a Birth Certificate, automatically extracts structured civil registration fields.\n7. Creates audit log.","operationId":"upload_and_process_document_api_v1_documents_upload_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_upload_and_process_document_api_v1_documents_upload_post"}}},"required":true},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentUploadResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/documents/{document_id}":{"get":{"tags":["Documents"],"summary":"Get Document Details","description":"Retrieves document metadata by ID.","operationId":"get_document_details_api_v1_documents__document_id__get","parameters":[{"name":"document_id","in":"path","required":true,"schema":{"type":"string","title":"Document Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentMetadataRespon